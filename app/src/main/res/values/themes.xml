<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this theme only covers window background and system bars -->
    <style name="Theme.Agora" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_secondary</item>
    </style>

    <style name="Theme.Agora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Agora</item>
    </style>
</resources>
